[market]
name = "ashare"
benchmark = "000300.SH"
max_positions = 5
min_position_holding_days = 1

[filters]
min_list_days = 60
min_price = 3.0
min_avg_turnover = 50000000
exclude_st = true
exclude_suspended = true

[pricing]
buy_markup = 0.003
sell_markdown = 0.003
cancel_if_gap_exceeds = 0.02

[strategy]
buy_top_n = 1
sell_top_n = 1
lookback_momentum_days = 20
lookback_short_days = 5
lookback_vol_days = 20

[backtest]
initial_cash = 1000000
commission_rate = 0.0003
stamp_duty_rate = 0.001
lot_size = 100

[runtime]
paper_start_date = "2026-02-02"
daily_run_time = "18:30"
timezone = "Asia/Shanghai"
sync_lookback_days = 7
calendar_ahead_days = 14

[selection]
enable_rebound_strategy = true
buy_momentum_weight = 0.25
buy_liquidity_weight = 0.15
buy_ma20_weight = 0.10
buy_ma10_weight = 0.05
buy_volatility_weight = 0.10
buy_volume_ratio_weight = 0.05
buy_trend_weight = 0.15
buy_pullback_weight = 0.15
buy_reversal_weight = 0.05
sell_momentum_weight = 0.45
sell_ma10_weight = 0.25
sell_ma20_weight = 0.20
sell_volatility_weight = 0.10
min_buy_score = 0.60
rotation_edge = 0.25
sell_health_exit_threshold = 0.35
market_min_breadth = 0.50
buy_min_close_to_ma20 = -0.03
buy_max_close_to_ma20 = 0.05
buy_min_pullback_from_20d_high = -0.15
buy_max_pullback_from_20d_high = -0.05
buy_min_momentum_5d = -0.02
buy_max_volume_ratio = 3.0
buy_min_amount_ratio_5d = 0.80
buy_max_amount_ratio_5d = 1.80
buy_max_return_1d = 0.035
buy_max_close_to_ma5 = 0.035
buy_max_low_to_prev_low = 0.04
buy_min_total_mv_yuan = 30000000000
stop_loss_pct = 0.08
take_profit_trigger_pct = 0.10
trailing_stop_drawdown_pct = 0.07
trend_exit_min_holding_days = 5
rotation_min_holding_days = 5
overheat_take_profit_close_to_ma20 = 0.18
overheat_min_profit_pct = 0.08
rebound_min_score = 0.60
rebound_max_close_to_ma60_below = 0.18
rebound_min_drawdown_20d = -0.08
rebound_min_drawdown_60d = -0.08
rebound_max_drawdown_60d = -0.35
rebound_max_down_days_10d = 7
rebound_min_return_3d = -0.01
rebound_max_return_3d = 0.16
rebound_max_close_to_ma5 = 0.12
rebound_max_close_to_ma20 = 0.10
rebound_min_amount_ratio_5d = 0.70
rebound_max_amount_ratio_5d = 2.20
rebound_max_volume_ratio = 3.00
rebound_ideal_max_return_3d = 0.08
rebound_ideal_max_close_to_ma5 = 0.06
rebound_ideal_max_close_to_ma20 = 0.03
rebound_max_volatility_20d = 0.08
rebound_min_large_net_mf_to_amount = -0.03
rebound_prefer_large_net_mf_to_amount = 0.02
rebound_market_min_breadth = 0.25
rebound_max_positions = 2
rebound_position_size_multiplier = 0.50
rebound_stop_loss_pct = 0.05
rebound_fast_exit_days = 3
rebound_breakeven_trigger_pct = 0.08
rebound_breakeven_floor_pct = 0.01
rebound_profit_lock_trigger_pct = 0.15
rebound_profit_lock_drawdown_pct = 0.06
rebound_big_profit_trigger_pct = 0.25
rebound_big_profit_drawdown_pct = 0.10
